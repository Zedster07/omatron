#!/usr/bin/env bash
# Desktop Agent setup and health check.
#
# Omarchy never runs an install hook for a plugin, by design -- adding a plugin
# must not be able to execute anything. So this is explicit and user-invoked:
# nothing here happens because you installed the plugin, only because you ran
# this or pressed the button in the panel.
set -uo pipefail

PLUGIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"




bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

doctor() {
  local missing=0
  bold "Desktop Agent — health check"

  echo; bold "Voice"
  for c in pw-record wtype socat wl-copy; do
    if have "$c"; then ok "$c"; else bad "$c is missing"; missing=1; fi
  done

  local sttmode; sttmode="$(desktop-agent-config get voice.sttMode 2>/dev/null || echo local)"

  if [[ "$sttmode" == "remote" ]]; then
    # Nothing local is required for a cloud endpoint, so nothing local is checked.
    ok "remote transcription (no local model, no venv)"
  else
    local venv="$HOME/.local/share/desktop-agent/venv"
    if [[ -x "$venv/bin/python" ]] && "$venv/bin/python" -c "import faster_whisper" 2>/dev/null; then
      ok "faster-whisper installed ($(du -sh "$venv" 2>/dev/null | cut -f1))"
    else
      bad "faster-whisper missing  (run: desktop-agent setup)"; missing=1
    fi

    local health
    health="$(desktop-agent-config stt-status 2>/dev/null)"
    if [[ "$health" == *'"ok": true'* ]]; then
      ok "speech service up — $(echo "$health" | grep -oE '"model": "[^"]+"' | cut -d'"' -f4)"
    else
      bad "speech service down  (systemctl --user start desktop-agent-stt)"; missing=1
    fi
  fi

  # Connecting, not just looking: a killed daemon leaves its socket behind, and
  # the file test reported a running daemon with nothing listening.
  if socat -u /dev/null "UNIX-CONNECT:${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-agent-voice.sock" 2>/dev/null; then
    ok "voice daemon running"
  else
    bad "voice daemon down  (systemctl --user start desktop-agent-voice)"; missing=1
  fi

  if [[ "$(desktop-agent-config get voice.sttMode 2>/dev/null)" == "remote" ]]; then
    if desktop-agent-config all 2>/dev/null | grep -q '"hasRemoteKey": true'; then
      ok "remote transcription configured"
    else
      bad "remote selected but no API key set"; missing=1
    fi
  fi

  if [[ "$(hyprctl getoption decoration:blur:enabled 2>/dev/null | head -1)" == *"1"* ]] \
     || [[ "$(hyprctl getoption decoration:blur:enabled 2>/dev/null | head -1)" == *"true"* ]]; then
    ok "compositor blur on (overlays read as a HUD)"
  else
    warn "compositor blur off — overlays still work, they just look flat  (desktop-agent keybinds)"
  fi

  if [[ -f "$HOME/.config/hypr/bindings.lua" ]] && grep -q "desktop-agent-listen" "$HOME/.config/hypr/bindings.lua" 2>/dev/null; then
    ok "command-mode keybinding present"
  else
    warn "no command-mode keybinding  (run: desktop-agent keybinds)"
  fi

  # Two things a fresh install gets wrong that nothing else notices.
  if [[ -L "$HOME/.local/bin/desktop-agent" || -x "$HOME/.local/bin/desktop-agent" ]]; then
    ok "commands linked into ~/.local/bin"
  else
    bad "commands not on PATH — F9 and the panel will silently do nothing  (run: desktop-agent link)"
  fi
  if [[ -n "$(find "$PLUGIN_DIR" -type l -not -path '*/.git/*' 2>/dev/null | head -1)" ]]; then
    bad "symlinks inside the plugin folder — 'omarchy plugin update' will fail validation and roll back  (run: desktop-agent mcp-install)"
  fi
  if [[ -d "$HOME/.config/omarchy/plugins/io.github.zedster07.desktop-agent" ]]; then
    ok "registered with the Omarchy shell"
  else
    bad "not installed as an Omarchy plugin — no panel, no HUD, no approval overlay  (omarchy plugin add https://github.com/Zedster07/omatron --enable)"
  fi

  echo; bold "Policy"
  if [[ -f "$HOME/.config/desktop-agent/policy.jsonc" ]]; then
    ok "policy present"
    # "Present" is not the same as "on". There are two independent off
    # switches -- the policy's master setting and the kill-switch flag below
    # -- and reporting only the file's existence is how the panel came to say
    # "policy active" on an install where everything refused.
    case "$(desktop-agent-config policy-enabled 2>/dev/null)" in
      true)  ok "desktop control on" ;;
      *)     warn "desktop control OFF in your policy — every gated action refuses  (Policy tab, or: desktop-agent-config policy-set-enabled true)" ;;
    esac
    case "$(desktop-agent-config policy-yolo 2>/dev/null)" in
      true)  warn "full access permitted — a lease auto-approves every ask while it runs" ;;
      *)     ok "full access not permitted — a lease would change nothing" ;;
    esac
  else
    bad "no policy — everything gated will refuse  (run: desktop-agent setup)"; missing=1
  fi
  if [[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/desktop-agent/disabled" ]]; then
    warn "kill switch is ON — every gated action refuses"
  fi

  echo; bold "Agent CLIs (optional — voice works without this)"
  if have bun; then ok "bun ($(command -v bun))"; else warn "bun is missing; the MCP half will not run"; fi
  # tmux is what makes the agent's commands watchable. Without it desktop_run
  # silently falls back to a pipe -- the commands still work, they just happen
  # invisibly, which is exactly the behaviour someone would file a bug about
  # rather than guess at.
  if have bwrap && have socat; then
    ok "bwrap + socat — agents that keep their own shell can be sandboxed away from the desktop"
  else
    warn "bwrap or socat missing; runners other than Claude cannot be sandboxed and will be refused"
  fi
  if have tmux; then
    ok "tmux ($(command -v tmux)) — agent commands run in a terminal you can watch"
  else
    warn "tmux is missing; agent commands will run through a pipe with nothing on screen"
  fi
  local found_agent=0
  for a in claude gemini codex opencode; do
    if have "$a"; then
      ok "$a ($(command -v "$a"))"
      found_agent=1
    fi
  done
  if [[ $found_agent -eq 0 ]]; then
    warn "no agent CLI installed on PATH (claude, gemini, codex, opencode); tier 4 requires one"
  fi

  echo; bold "Shell"
  if qs -p /usr/share/omarchy/shell ipc call io.github.zedster07.desktop-agent status >/dev/null 2>&1; then
    ok "plugin service is live"
  else
    bad "plugin service is not responding — is the plugin enabled in shell.json?"; missing=1
  fi

  echo
  # Name what is actually left, rather than sending someone back to a command
  # they have just run. After a successful setup the remaining steps are things
  # setup cannot do for you -- a key you have to fetch, and keybindings you have
  # to paste -- so saying "run setup" is both wrong and a dead end.
  echo
  if [[ $missing -eq 0 ]]; then
    bold "All good."
  else
    bold "What is left"
    [[ -f "$HOME/.config/desktop-agent/policy.jsonc" ]] || echo "  desktop-agent setup            seed the policy and start the daemon"
    [[ -L "$HOME/.local/bin/desktop-agent" ]]           || echo "  desktop-agent link             put the commands on PATH"
    if [[ -f "$HOME/.config/desktop-agent/settings.json" ]] && ! [[ -s "$HOME/.config/desktop-agent/stt.key" ]]; then
      echo "  a Groq API key                 paste it into the panel's voice tab (console.groq.com)"
    fi
    grep -q 'desktop-agent-listen' "$HOME/.config/hypr/bindings.lua" 2>/dev/null \
      || echo "  desktop-agent keybinds         print the bindings to paste into hypr"
    have claude && ! grep -q '"desktop"' "$HOME/.claude.json" 2>/dev/null \
      && echo "  desktop-agent mcp-install      give the agent the desktop tools"
  fi
  return $missing
}

# Omarchy binds dictation itself (F9 push-to-talk, SUPER+CTRL+X toggle), so
# this adds exactly one binding: the one that arms command mode before handing
# off to voxtype. Existing dictation muscle memory is left alone.
# Omarchy binds dictation itself (F9 push-to-talk, SUPER+CTRL+X toggle), so
# this adds exactly one binding: the one that arms command mode. Existing
# dictation muscle memory is left alone.
#
# The blur block is optional but is what makes the voice HUD read as a heads-up
# display rather than a window. It is close to free on a default Omarchy setup
# because every window is fully opaque, so there is nothing translucent for the
# compositor to blur behind -- the cost lands only on the two layer rules, and
# only while one of those surfaces is on screen.
keybinds() {
  cat <<'BINDS'

Add to ~/.config/hypr/bindings.lua:

    -- This plugin owns the speech path now, so unbind voxtype's keys first;
    -- two things listening on one key race for the microphone.
    hl.unbind("F9")
    hl.unbind("SUPER + CTRL + X")

    o.bind("F9",  "Dictate",             "desktop-agent-listen start dictate")
    o.bind("F9",  "Dictate (stop)",      "desktop-agent-listen stop",    { release = true })
    o.bind("F10", "Voice command",       "desktop-agent-listen start command")
    o.bind("F10", "Voice command (stop)","desktop-agent-listen stop",    { release = true })
    o.bind("SUPER + F2", "Stop agent / cancel voice", "desktop-agent-listen cancel")

    -- Type a request instead of speaking it. Same pipeline behind it.
    --
    -- SPACE, not a punctuation key: on a non-US layout "/" may need Shift and
    -- may not be in the same place at all. Space is the same physical key
    -- everywhere, and this sits beside the launcher on SUPER+SPACE.
    o.bind("SUPER + F1", "Command prompt",
           "omarchy-shell io.github.zedster07.desktop-agent prompt")

These lines are yours once you paste them: nothing here writes to that file,
and nothing removes them later. If you ever uninstall this plugin, delete them
too -- the unbind lines keep working after the plugin is gone, so F9 would stay
dead and Omarchy's own dictation would not come back. `desktop-agent uninstall`
prints them with line numbers when the time comes.

Optional, in ~/.config/hypr/looknfeel.lua, for blur behind the overlays:

    hl.config({
      decoration = { blur = { enabled = true, size = 6, passes = 2,
                              new_optimizations = true, ignore_opacity = true } },
    })
    hl.layer_rule({ match = { namespace = "omarchy-desktop-agent-voice" }, blur = true })
    hl.layer_rule({ match = { namespace = "omarchy-desktop-agent-approval" }, blur = true })
    hl.layer_rule({ match = { namespace = "omarchy-desktop-agent-prompt" }, blur = true })

BINDS
}

case "${1:-doctor}" in
  doctor) doctor ;;
  link)
    # Put the commands where a shell can find them.
    #
    # Everything else assumes this and nothing did it. The messages say "run:
    # desktop-agent setup", the panel shells out to `desktop-agent-config all`,
    # and the keybindings people paste call `desktop-agent-listen start
    # dictate` -- so without this, F9 does nothing and the panel shows
    # fallbacks for every reading. It worked during development only because
    # the author had already put it on PATH by hand, which is the most
    # dangerous kind of setup step: invisible to the person who took it.
    mkdir -p "$HOME/.local/bin"
    for f in "$PLUGIN_DIR"/bin/*; do
      n="$(basename "$f")"
      ln -sfn "$f" "$HOME/.local/bin/$n"
      ok "$n -> ~/.local/bin"
    done
    case ":$PATH:" in
      *":$HOME/.local/bin:"*) ;;
      *) warn "~/.local/bin is not on your PATH — add it to your shell profile, or the commands above will not be found" ;;
    esac
    ;;

  setup)
    mkdir -p "$HOME/.config/desktop-agent" "$UNITS"

    # Seed the policy on first run.
    #
    # Without a policy the engine fails closed and refuses everything, which is
    # correct and looks completely broken. An existing policy is never touched:
    # it is the security boundary and the user's own edits live in it.
    if [[ ! -f "$HOME/.config/desktop-agent/policy.jsonc" ]]; then
      cp "$PLUGIN_DIR/server/policy.default.jsonc" "$HOME/.config/desktop-agent/policy.jsonc"
      ok "policy seeded at ~/.config/desktop-agent/policy.jsonc"

    # Before anything that tells the user to run a command by name.
    bold "Linking commands into ~/.local/bin"
    "$0" link
    else
      ok "policy already present — left alone"
    fi
    bun_path="$(command -v bun || echo /usr/bin/bun)"
    sed -e "s|ExecStart=.*voiced.ts|ExecStart=$bun_path $PLUGIN_DIR/voice/voiced.ts|" \
        "$PLUGIN_DIR/systemd/desktop-agent-voice.service" > "$UNITS/desktop-agent-voice.service"
    systemctl --user daemon-reload
    systemctl --user enable --now desktop-agent-voice.service
    ok "voice daemon started"

    # Nothing is downloaded here. Transcription defaults to a cloud endpoint,
    # which needs a key and no disk; local is offered in the panel and only
    # installs after an explicit yes with the size on screen.
    if desktop-agent-config all 2>/dev/null | grep -q '"hasRemoteKey": true'; then
      ok "API key set — transcription ready"
    else
      echo
      bold "One thing left: an API key"
      echo "  Transcription runs against a cloud endpoint by default, so there is"
      echo "  nothing to download. Get a free key at https://console.groq.com and"
      echo "  paste it into the panel's voice tab."
      echo
      echo "  Prefer to keep audio on this machine? Pick 'local' in the same tab."
      echo "  It will tell you the download size and ask before fetching anything."
    fi

    keybinds
    doctor
    ;;
  uninstall)
    # Everything this plugin leaves outside its own directory.
    #
    # Deleting the plugin removes the code and nothing else: the timers, the
    # daemon unit and the agent's saved state all live elsewhere. Scheduled
    # jobs clean themselves up on their next firing, but "next firing" for a
    # yearly job is a year, so this removes them now.
    bold "Removing scheduled jobs"
    bun run "$PLUGIN_DIR/voice/jobs-cli.ts" cancel all
    bold "Stopping services"
    for u in desktop-agent-voice desktop-agent-stt; do
      systemctl --user disable --now "$u.service" >/dev/null 2>&1 && ok "$u stopped" || true
    done
    # The keybindings are the one thing that leaves the machine WORSE than it
    # was found. Everything else this plugin adds simply stops; the unbind
    # lines keep working after the plugin is gone, so F9 does nothing and the
    # dictation the OS shipped with stays dead. Silence here would look like
    # Omarchy broke.
    if grep -q 'hl.unbind("F9")' "$HOME/.config/hypr/bindings.lua" 2>/dev/null; then
      echo
      bold "Your keybindings still point at this plugin"
      echo "  ~/.config/hypr/bindings.lua contains lines this plugin asked you to add."
      echo "  Left alone, F9 stays unbound and Omarchy's own dictation will not come back."
      echo
      echo "  Delete these from that file:"
      grep -n 'desktop-agent-listen\|desktop-agent prompt\|hl.unbind("F9")\|hl.unbind("SUPER + CTRL + X")' \
        "$HOME/.config/hypr/bindings.lua" 2>/dev/null | sed 's/^/    /'
      echo
      echo "  Then reload:  hyprctl reload"
      echo "  Voxtype's F9 and SUPER+CTRL+X come back on their own once the unbinds are gone."
    fi

    bold "State kept, in case this is a reinstall"
    echo "  policy:   $HOME/.config/desktop-agent/policy.jsonc"
    echo "  settings: $HOME/.config/desktop-agent/settings.json"
    echo "  reports:  $HOME/.local/state/desktop-agent/runs/"
    echo "  audit:    $HOME/.local/share/desktop-agent/desktop.log"
    echo
    echo "  Remove those by hand if you want them gone:"
    echo "    rm -rf ~/.config/desktop-agent ~/.local/state/desktop-agent ~/.local/share/desktop-agent"
    ok "done — the plugin directory can now be deleted"
    ;;

  remind)
    # A reminder without an agent.
    #
    # Deliberately reachable as a plain command, so tier 3 can answer "remind
    # me at 6 to take the bins out" with one deterministic call instead of
    # spending an agent hand-off on a notification. The expensive tier should
    # be for work, not for remembering.
    [[ -n "${3:-}" ]] || { bad 'usage: desktop-agent remind "<when>" "<text>"'; exit 1; }
    bun run "$PLUGIN_DIR/voice/jobs-cli.ts" remind "$2" "$3"
    ;;

  jobs-json)
    bun run "$PLUGIN_DIR/voice/jobs-cli.ts" list-json
    ;;

  jobs)
    # Everything scheduled, in one place.
    #
    # The panel will list these too, but a schedule you can only inspect
    # through a GUI is one you cannot check from a terminal at 2am when
    # something has just fired and you want to know why.
    bun run "$PLUGIN_DIR/voice/jobs-cli.ts" list
    ;;

  job-cancel)
    [[ -n "${2:-}" ]] || { bad "usage: desktop-agent job-cancel <id|all>"; exit 1; }
    bun run "$PLUGIN_DIR/voice/jobs-cli.ts" cancel "$2"
    ;;

  stop)
    # Stop a running agent from a terminal.
    #
    # The daemon's "cancel" abandons a recording, closes the prompt and kills
    # the agent's whole process tree. All three routes -- this, Super+F2, and
    # the stop button on the corner readout -- end at the same place; what was
    # missing was a name you could guess.
    if desktop-agent-listen cancel 2>/dev/null; then
      ok "stop sent"
    else
      bad "could not reach the voice daemon  (systemctl --user status desktop-agent-voice)"
      exit 1
    fi
    ;;

  agent-check)
    # Does the tier-4 hand-off actually confine the agent?
    #
    # Worth a subcommand because the confinement is a DENYLIST -- Claude Code
    # has no "only these tools" switch that survives bypassPermissions -- so
    # any tool added in a future release starts out permitted. This asks the
    # agent to enumerate its own surface and fails if anything outside the
    # desktop server comes back. Re-run it after upgrading Claude Code.
    settings="$HOME/.local/state/desktop-agent/agent-settings.json"
    mcp="$HOME/.local/state/desktop-agent/agent-mcp.json"
    if [[ ! -f "$settings" || ! -f "$mcp" ]]; then
      bad "no agent config yet — run one voice/text request through tier 4 first"
      exit 1
    fi
    bold "Asking the agent what tools it holds"
    tools=$(timeout 150 claude -p "Reply with ONLY the comma-separated list of tool names you may use. No prose." \
      --permission-mode bypassPermissions \
      --strict-mcp-config --mcp-config "$mcp" --settings "$settings" < /dev/null 2>/dev/null \
      | tr '\n' ' ')
    if [[ -z "$tools" ]]; then bad "no answer from the agent CLI"; exit 1; fi
    # Whole answer joined onto one line before splitting, not tail -1. A wrapped
    # reply made tail -1 start mid-list, so the first token arrived without its
    # mcp__desktop__ prefix and was reported as a leaked tool. A security check
    # that cries wolf gets ignored, which is worse than not having one.
    leaked=$(echo "$tools" | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -v '^mcp__desktop__' | grep -v '^$' || true)
    if [[ -n "$leaked" ]]; then
      bad "agent holds tools outside the desktop server:"
      echo "$leaked" | sed 's/^/    /'
      echo "    -> add these to DENIED_TOOLS in voice/agent.ts"
      exit 1
    fi
    ok "confined: $(echo "$tools" | tr ',' '\n' | grep -c 'mcp__desktop__') desktop tools, nothing else"

    # The check above only covers Claude, which is the only runner that claims
    # to be confinable. Say so out loud rather than letting a green tick read
    # as "the agent tier is safe" when three other runners can be selected.
    echo
    bold "Other runners"
    for r in gemini codex opencode; do
      if command -v "$r" >/dev/null 2>&1; then
        printf '  \033[33m!\033[0m %-9s installed — NOT confinable, keeps its own shell.\n' "$r"
      else
        printf '  \033[2m·\033[0m %-9s not installed\n' "$r"
      fi
    done
    allow=$(desktop-agent-config get agent.allowUnconfined 2>/dev/null || echo false)
    if [[ "$allow" == "true" ]]; then
      bad "agent.allowUnconfined is TRUE — an unconfined runner may be used, and the desktop policy will not see what it does through its own shell"
    else
      ok "agent.allowUnconfined is false — only confined runners will run"
    fi
    ;;

  mcp-install)
    # Register the MCP server that ships WITH this plugin into Claude Code, Gemini, Codex, or OpenCode.
    have bun || { bad "bun is required for the agent half"; exit 1; }
    if [[ ! -d "$PLUGIN_DIR/server/node_modules" ]]; then
      bold "Installing server dependencies"
      (cd "$PLUGIN_DIR/server" && bun install) || { bad "bun install failed"; exit 1; }
      # Omarchy's plugin validator rejects symlinks anywhere inside a plugin
      # folder, and `bun install` leaves one: node_modules/.bin/node-which.
      # With it there, `omarchy plugin update` fails validation and rolls back
      # -- so installing the agent half quietly broke every future update, and
      # the only symptom was an update that said it had been undone.
      #
      # Nothing here runs a dependency's CLI; .bin exists for a convenience we
      # do not use.
      find "$PLUGIN_DIR/server/node_modules" -type l -delete 2>/dev/null || true
      rmdir "$PLUGIN_DIR/server/node_modules/.bin" 2>/dev/null || true
    fi
    target="${2:-all}"
    bold "Registering Desktop MCP server (target: $target)"
    python3 - "$PLUGIN_DIR" "$(command -v bun)" "$target" <<'PY'
import json, os, shutil, sys, time
plugin, bun, target = sys.argv[1], sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "all"
target = target.lower()
server_ts = os.path.join(plugin, "server", "server.ts")
installed_any = False

# Claude Code
if target in ("all", "claude"):
    cfg = os.path.expanduser("~/.claude.json")
    if os.path.exists(cfg):
        try:
            shutil.copy(cfg, f"{cfg}.bak.{int(time.time())}")
            d = json.load(open(cfg))
            servers = d.setdefault("mcpServers", {})
            servers["desktop"] = {
                "type": "stdio",
                "command": bun,
                "args": ["run", server_ts],
                "env": { "DESKTOP_AGENT_IDENTITY": "claude" },
            }
            json.dump(d, open(cfg, "w"), indent=2)
            print("  ✓ Claude Code (~/.claude.json): registered")
            installed_any = True
        except Exception as e:
            print(f"  ✗ Claude Code: failed to update ({e})")
    elif target == "claude":
        print("  ✗ Claude Code: ~/.claude.json not found (start Claude Code once first)")

# Gemini CLI
if target in ("all", "gemini"):
    cfg = os.path.expanduser("~/.gemini/settings.json")
    if os.path.exists(os.path.dirname(cfg)):
        try:
            d = {}
            if os.path.exists(cfg):
                shutil.copy(cfg, f"{cfg}.bak.{int(time.time())}")
                try: d = json.load(open(cfg))
                except Exception: d = {}
            servers = d.setdefault("mcpServers", {})
            servers["desktop"] = {
                "command": bun,
                "args": ["run", server_ts],
                "env": { "DESKTOP_AGENT_IDENTITY": "gemini" },
            }
            json.dump(d, open(cfg, "w"), indent=2)
            print("  ✓ Gemini CLI (~/.gemini/settings.json): registered")
            installed_any = True
        except Exception as e:
            print(f"  ✗ Gemini CLI: failed to update ({e})")
    elif target == "gemini":
        print("  ✗ Gemini CLI: ~/.gemini directory not found")

# Codex CLI
if target in ("all", "codex"):
    cfg = os.path.expanduser("~/.codex/config.toml")
    if os.path.exists(os.path.dirname(cfg)):
        try:
            content = ""
            if os.path.exists(cfg):
                content = open(cfg).read()
                shutil.copy(cfg, f"{cfg}.bak.{int(time.time())}")
            snippet = f'[mcp_servers.desktop]\ncommand = "{bun}"\nargs = ["run", "{server_ts}"]\nenv = {{ DESKTOP_AGENT_IDENTITY = "codex" }}\n'
            # Rewrite the block rather than skipping it when one exists.
            #
            # This used to print "already present" and change nothing, which
            # made every re-install a no-op that reported success. So when the
            # server moved -- renamed from omarchy-desktop-agent, and out of
            # the dev clone into the plugin directory -- codex kept pointing at
            # a path that no longer existed, and said it was fine each time.
            # The other three runners are JSON and get overwritten wholesale,
            # so they healed on the next install and codex alone did not.
            lines = content.split("\n")
            start = next((i for i, l in enumerate(lines)
                          if l.strip() == "[mcp_servers.desktop]"), None)
            if start is None:
                with open(cfg, "a") as f:
                    f.write(("" if content.endswith("\n") or not content else "\n") + "\n" + snippet)
                print("  ✓ Codex CLI (~/.codex/config.toml): registered")
            else:
                # A TOML table runs to the next table header or end of file.
                end = next((i for i in range(start + 1, len(lines))
                            if lines[i].lstrip().startswith("[")), len(lines))
                was = "\n".join(lines[start:end])
                lines[start:end] = snippet.rstrip("\n").split("\n") + [""]
                open(cfg, "w").write("\n".join(lines))
                if server_ts in was:
                    print("  ✓ Codex CLI (~/.codex/config.toml): already current")
                else:
                    print("  ✓ Codex CLI (~/.codex/config.toml): updated (it pointed somewhere else)")
            installed_any = True
        except Exception as e:
            print(f"  ✗ Codex CLI: failed to update ({e})")
    elif target == "codex":
        print("  ✗ Codex CLI: ~/.codex directory not found")

# OpenCode CLI
if target in ("all", "opencode"):
    cfg = os.path.expanduser("~/.config/opencode/opencode.json")
    if os.path.exists(os.path.dirname(cfg)):
        try:
            d = {}
            if os.path.exists(cfg):
                shutil.copy(cfg, f"{cfg}.bak.{int(time.time())}")
                try: d = json.load(open(cfg))
                except Exception: d = {}
            mcp = d.setdefault("mcp", {})
            mcp["desktop"] = {
                "type": "local",
                "command": [bun, "run", server_ts],
                "environment": { "DESKTOP_AGENT_IDENTITY": "opencode" },
                "enabled": True,
            }
            json.dump(d, open(cfg, "w"), indent=2)
            print("  ✓ OpenCode CLI (~/.config/opencode/opencode.json): registered")
            installed_any = True
        except Exception as e:
            print(f"  ✗ OpenCode CLI: failed to update ({e})")
    elif target == "opencode":
        print("  ✗ OpenCode CLI: ~/.config/opencode directory not found")

print(f"\n  Server: {server_ts}")
PY
    ok "MCP server registration complete"
    ;;

  install-stt-unit)
    # Called by desktop-agent-config when someone opts into local. The unit is
    # not installed at plugin-install time because most users will never run a
    # local model.
    mkdir -p "$UNITS"
    venv="$HOME/.local/share/desktop-agent/venv"
    sed -e "s|ExecStart=%h/.local/share/desktop-agent/venv/bin/python .*|ExecStart=$venv/bin/python $PLUGIN_DIR/stt/server.py|" \
        "$PLUGIN_DIR/systemd/desktop-agent-stt.service" > "$UNITS/desktop-agent-stt.service"
    systemctl --user daemon-reload
    ;;
  keybinds)
    keybinds
    echo "Checking the commands those bindings run:"
    for c in desktop-agent-listen omarchy-shell; do
      if have "$c"; then ok "$c on PATH"; else bad "$c missing — the binding will do nothing"; fi
    done
    if omarchy-shell io.github.zedster07.desktop-agent status >/dev/null 2>&1; then
      ok "omarchy-shell reaches the plugin"
    else
      bad "omarchy-shell cannot reach the plugin — is the shell running with it enabled?"
    fi
    echo "Checking those against what Hyprland actually has bound:"
    python3 - <<'PY'
import json, subprocess, sys
try:
    binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"],
                                      capture_output=True, text=True).stdout)
except Exception:
    print("  (hyprland not running — cannot check)"); sys.exit(0)

def mods(m):
    return "+".join(n for bit, n in [(64,"SUPER"),(8,"ALT"),(4,"CTRL"),(1,"SHIFT")] if m & bit)

# A key legitimately carries two bindings when one is press and one is
# release -- that is how push-to-talk works. Only two bindings with the SAME
# release flag are a real collision.
taken = {}
for b in binds:
    k = (b.get("key") or "").strip().upper()
    if k:
        taken.setdefault((mods(b["modmask"]), k), []).append(
            (bool(b.get("release")), b.get("description") or ""))

# `omarchy menu keybindings --print` lists only bindings that were given a
# description, so a binding registered without one looks free and is not.
# This reads Hyprland's own table instead.
ours = {"Dictate", "Dictate (stop)", "Voice command", "Voice command (stop)",
        "Cancel voice", "Command prompt"}
for m, k in [("", "F9"), ("", "F10"), ("SUPER", "F1"), ("SUPER", "F2")]:
    label = (m + " + " if m else "") + k
    entries = taken.get((m, k), [])
    foreign = [d for rel, d in entries if d not in ours]
    presses = [d for rel, d in entries if not rel]
    if not entries:
        print(f"  free       {label}")
    elif foreign:
        print(f"  COLLISION  {label} — also bound to: {', '.join(foreign)}")
    elif len(presses) > 1:
        print(f"  COLLISION  {label} — {len(presses)} press bindings")
    else:
        print(f"  ours       {label}")
PY
    ;;
  *)
    # Listed in full because the one command people go looking for under
    # pressure is "stop", and it was not discoverable anywhere: not here, not
    # in the panel, and bound to a key labelled after a different feature.
    cat <<'USAGE'
usage: desktop-agent <command>

  stop                    stop a running agent (also: Super+F2, or the
                          stop button on the corner readout)
  doctor                  health check
  setup                   install everything and register the keybinds
  uninstall               remove keybinds, schedules, units and state

  jobs                    list scheduled reminders and tasks
  job-cancel <id|all>     cancel one, or all of them
  remind "<when>" "<what>"  schedule a notification

  link                    symlink the commands into ~/.local/bin
  mcp-install             register the MCP server with the agent CLIs
  agent-check             prove the tier-4 hand-off is actually confined
  keybinds                print the keybindings this plugin installs

Settings, the policy switches and the capability table live in the panel:
click the bar icon, then Policy.
USAGE
    exit 2 ;;
esac
